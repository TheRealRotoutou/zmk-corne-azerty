#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB   &kp Q      &kp W      &kp E      &kp R      &kp T        &kp Y      &kp U      &kp I      &kp O      &kp P      &kp BSPC
&kp LCTRL &kp A      &kp S      &kp D      &kp F      &kp G        &kp H      &kp J      &kp K      &kp L      &kp SEMI   &kp SQT
&kp LSHFT &kp Z      &kp X      &kp C      &kp V      &kp B        &none      &none      &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH   &kp ESC
                      &kp LGUI  &mo 1      &kp SPACE  &kp RET      &mo 2      &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "Bluetooth";
            bindings = <
&kp TAB   &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &kp N6      &kp N7      &kp N8      &kp N9      &kp N0      &kp BSPC
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &out OUT_USB &out OUT_BLE
/* Both center keys enter the local half's bootloader; outer thumbs soft-reset. */
&kp LSHFT &trans       &trans       &trans       &trans       &trans       &bootloader &bootloader &trans      &trans      &trans      &trans      &trans      &trans
                       &sys_reset   &trans       &kp SPACE   &kp RET      &trans      &sys_reset
            >;
            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            display-name = "Symbols";
            bindings = <
&kp TAB   &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL &trans    &trans    &trans    &trans    &trans       &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT &trans   &trans    &trans    &trans    &trans       &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans
                      &kp LGUI &trans   &kp SPACE &kp RET      &trans    &kp RALT
            >;
            sensor-bindings = <&inc_dec_kp UP DOWN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
